{
  "note": "Frames written by the client, read by the store. Both sides decode these bytes and must agree field for field.",
  "header": "u8 version | u8 type | u32be id | u32be length | payload[length]",
  "version": 1,
  "headerBytes": 10,
  "types": {
    "hello": 1,
    "welcome": 2,
    "ping": 3,
    "pong": 4,
    "invoke": 5,
    "result": 6,
    "failure": 7,
    "subscribe": 8,
    "event": 9,
    "goodbye": 10,
